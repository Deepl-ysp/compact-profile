{
  "name": "compact-profile",
  "version": "1.1.0",
  "description": "A compact configuration language that compiles to JS objects with type inference.",
  "type": "module",
  "main": "./dist/CompactProfile.js",
  "types": "./dist/CompactProfile.d.ts",
  "exports": {
    ".": {
      "types": "./dist/CompactProfile.d.ts",
      "default": "./dist/CompactProfile.js"
    }
